// lib/googleDrive.ts
// Milestone 12 scaffold — Google Drive cloud provider, mirroring lib/github.ts's
// shape. Pure fetch-based: no store or localStorage access here, so this stays
// trivially mockable in tests (see lib/github.test.ts for the pattern to follow).
//
// Auth model (client-side only, no backend/secret):
//   - Google Identity Services token client (google.accounts.oauth2.initTokenClient)
//   - Scope: https://www.googleapis.com/auth/drive.file
//   - CDN script: https://accounts.google.com/gsi/client
//     NOTE: a scripted HEAD/GET check from this machine could not confirm
//     reachability either way (likely bot/User-Agent filtering on Google's
//     side, not a real outage) — verify by loading the URL in an actual
//     browser before relying on this note.

import type {
  CloudCredentials,
  CloudSettingsPayload,
  PaperIndexEntry,
  SavedPaper,
  ExamMeta,
  AppConfig,
} from '@/types';

/**
 * Google-specific equivalent of lib/github.ts's GitHubAuthResult.
 * NOT the same type — GitHubAuthResult is GitHub-specific and should not be
 * reused here. Adjust fields once initTokenClient's real callback payload
 * (and any Drive bout.get identity check) is confirmed.
 */
export interface GoogleAuthResult {
  valid: boolean;
  email?: string;
  error?: string;
}

/**
 * Sketch of the CloudCredentials-equivalent shape for Google, per HANDOFF.md's
 * Milestone 12 design notes. Adjust field names once initTokenClient's actual
 * callback payload is confirmed against the live Google Identity Services API.
 */
export interface GoogleCredentials {
  accessToken: string;
  expiresAt: number; // epoch ms
  email: string;
}

/**
 * Mirrors lib/github.ts's alidateGitHubToken shape for Google.
 * TODO(Milestone 12): implement using Drive's bout.get endpoint (or
