// lib/googleDrive.ts
// Milestone 12 scaffold — Google Drive cloud provider, mirroring lib/github.ts's
// shape. Pure fetch-based: no store or localStorage access here, so this stays
// trivially mockable in tests (see lib/github.test.ts for the pattern to follow).
//
// Auth model (client-side only, no backend/secret):
//   - Google Identity Services token client (google.accounts.oauth2.initTokenClient)
//   - Scope: https://www.googleapis.com/auth/drive.file
//   - CDN script: https://accounts.google.com/gsi/client
//     (reachability confirmed by this discovery script: NOT REACHABLE — verify network/DNS before proceeding)

/**
 * Sketch of the CloudCredentials-equivalent shape for Google, per HANDOFF.md's
 * Milestone 12 design notes. Adjust field names once initTokenClient's actual
 * callback payload is confirmed against the live Google Identity Services API.
 */
export interface GoogleCredentials {
  accessToken: string;
  expiresAt: number; // epoch ms
  email: string;
}

/**
 * Mirrors lib/github.ts's $(@{Name=validateGitHubToken; Params=token: string; ReturnType=Promise<GitHubAuthResult>}.Name) shape for the Google Drive provider.
 * TODO(Milestone 12): implement using the Drive REST API (drive.file scope).
 */
export async function validateGitHubToken(token: string): Promise<GitHubAuthResult> {
  throw new Error('googleDrive.validateGitHubToken not yet implemented (Milestone 12 scaffold)');
}

